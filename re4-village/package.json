  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
